(load "Test.carp")
(load "../bufio.carp")
(relative-include "mock_stream.h")

(register mock-bufreader-create
  (Fn [&String Int] BufReader)
  "mock_bufreader_create")
(register mock-set-write-limits (Fn [Int Int Int] ()) "mock_set_write_limits")
(register mock-set-read-limits (Fn [Int Int] ()) "mock_set_read_limits")
(register mock-buffered-write-len
  (Fn [&BufReader] Int)
  "mock_buffered_write_len")
(register mock-read-n-raw (Fn [&BufReader Int] Int) "mock_read_n_raw")
(register mock-starve-buffers (Fn [&BufReader] ()) "mock_starve_buffers")
(register bufio-next-cap-long (Fn [Long Long] Long) "bufio_next_cap_long")
(register mock-get-output (Fn [] String) "mock_get_output")
(register mock-is-closed? (Fn [] Bool) "mock_is_closed")
(register mock-cleanup (Fn [] ()) "mock_cleanup")
(register mock-bytes-to-string
  (Fn [&(Array Byte)] String)
  "mock_bytes_to_string")

(use Test)

(deftest test
  (assert-equal test "hello
" &(let-do [br (mock-bufreader-create "hello
world
" 0)
            r (BufReader.read-line &br)] (BufReader.delete br) (mock-cleanup) (match r
        (Result.Success s) s
        (Result.Error _) @"ERROR")) "read-line returns first line with newline")

  (assert-equal test "world
" &(let-do [br (mock-bufreader-create "hello
world
" 0)
            _first-line (BufReader.read-line &br)
            r (BufReader.read-line &br)] (BufReader.delete br) (mock-cleanup) (match r
        (Result.Success s) s
        (Result.Error _) @"ERROR")) "read-line returns second line")

  (assert-equal test
    "no newline"
    &(let-do [br (mock-bufreader-create "no newline" 0)
              r (BufReader.read-line &br)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r (Result.Success s) s (Result.Error _) @"ERROR"))
    "read-line returns remaining data at EOF without newline")

  (assert-equal test
    "connection closed"
    &(let-do [br (mock-bufreader-create "" 0)
              r (BufReader.read-line &br)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e))
    "read-line returns error on empty stream")

  (assert-equal test
    "read error"
    &(let-do [br (mock-bufreader-create "partial line without a newline" 0)]
      (mock-set-read-limits 7 -1)
      (let-do [r (BufReader.read-line &br)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e)))
    "a read error partway through a line is not a successful short line")

  (assert-equal test
    "read error"
    &(let-do [br (mock-bufreader-create "hello" 0)]
      (mock-set-read-limits 0 -1)
      (let-do [r (BufReader.read-line &br)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e)))
    "a read error with nothing buffered is distinct from a closed connection")

  (assert-equal test
    "key;"
    &(let-do [br (mock-bufreader-create "key;value;" 0)
              r (BufReader.read-until &br \;)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r (Result.Success s) s (Result.Error _) @"ERROR"))
    "read-until stops at delimiter")

  (assert-equal test
    "no delim here"
    &(let-do [br (mock-bufreader-create "no delim here" 0)
              r (BufReader.read-until &br \;)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r (Result.Success s) s (Result.Error _) @"ERROR"))
    "read-until returns all data when delimiter not found")

  (assert-equal test
    "read error"
    &(let-do [br (mock-bufreader-create "keyvalue;" 0)]
      (mock-set-read-limits 3 -1)
      (let-do [r (BufReader.read-until &br \;)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e)))
    "a read error partway through read-until is not a successful short read")

  (assert-equal test
    "keyvalue;"
    &(let-do [br (mock-bufreader-create "keyvalue;" 0)]
      (mock-set-read-limits 3 -1)
      (ignore (BufReader.read-until &br \;))
      (mock-set-read-limits -1 -1)
      (let-do [r (BufReader.read-until &br \;)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success s) s (Result.Error _) @"ERROR")))
    "retrying a failed read-until resumes instead of losing the buffered prefix")

  (assert-equal test
    "hello"
    &(let-do [br (mock-bufreader-create "hello world" 0)
              r (BufReader.read-n &br 5)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r
        (Result.Success arr) (mock-bytes-to-string &arr)
        (Result.Error _) @"ERROR"))
    "read-n returns exact bytes requested")

  (assert-equal test
    "hi"
    &(let-do [br (mock-bufreader-create "hi" 0)
              r (BufReader.read-n &br 10)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r
        (Result.Success arr) (mock-bytes-to-string &arr)
        (Result.Error _) @"ERROR"))
    "read-n returns fewer bytes at EOF")

  (assert-equal test
    "read error"
    &(let-do [br (mock-bufreader-create "hello world" 0)]
      (mock-set-read-limits 3 -1)
      (let-do [r (BufReader.read-n &br 10)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e)))
    "a read error partway through read-n is not a successful short read")

  (assert-equal test
    "read error"
    &(let-do [br (mock-bufreader-create "hello" 0)]
      (mock-set-read-limits 0 -1)
      (let-do [r (BufReader.read-n &br 5)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e)))
    "read-n tells a failed read from a closed connection")

  (assert-equal test
    "connection closed"
    &(let-do [br (mock-bufreader-create "" 0)
              r (BufReader.read-n &br 5)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e))
    "read-n returns error on empty stream")

  (assert-equal test
    "invalid count"
    &(let-do [br (mock-bufreader-create "hello world" 0)
              r (BufReader.read-n &br -1)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e))
    "read-n rejects a negative count instead of crashing")

  (assert-equal test
    "invalid count"
    &(let-do [br (mock-bufreader-create "hello world" 0)
              r (BufReader.read-n &br 0)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e))
    "read-n rejects a count of zero")

  (assert-equal test
    "hello"
    &(let-do [br (mock-bufreader-create "hello world" 0)
              _rejected (BufReader.read-n &br -1)
              r (BufReader.read-n &br 5)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r
        (Result.Success arr) (mock-bytes-to-string &arr)
        (Result.Error _) @"ERROR"))
    "a rejected count leaves the stream where it was")

  (assert-equal test
    0
    (let-do [br (mock-bufreader-create "hello world" 0)
             n (mock-read-n-raw &br -1)]
      (BufReader.delete br)
      (mock-cleanup)
      n)
    "the C entry point reads nothing for a negative count")

  (assert-equal test
    5
    (let-do [br (mock-bufreader-create "hello world" 0)
             n (mock-read-n-raw &br 5)]
      (BufReader.delete br)
      (mock-cleanup)
      n)
    "the C entry point still reads a positive count")

  (assert-equal test
    5
    (let-do [br (mock-bufreader-create "hello" 0)
             buf (Array.replicate 0 &(Byte.from-int 0))
             r (BufReader.read-append &br &buf)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r (Result.Success n) n (Result.Error _) -1))
    "read-append returns byte count")

  (assert-equal test
    0
    (let-do [br (mock-bufreader-create "" 0)
             buf (Array.replicate 0 &(Byte.from-int 0))
             r (BufReader.read-append &br &buf)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r (Result.Success n) n (Result.Error _) -1))
    "read-append reports the end of the stream as zero bytes, not an error")

  (assert-equal test
    "read error"
    &(let-do [br (mock-bufreader-create "hello" 0)
              buf (Array.replicate 0 &(Byte.from-int 0))]
      (mock-set-read-limits 0 -1)
      (let-do [r (BufReader.read-append &br &buf)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e)))
    "read-append reports a failed read as an error")

  (assert-equal test
    "read error"
    &(let-do [br (mock-bufreader-create "hello" 0)
              buf (Array.replicate 0 &(Byte.from-int 0))]
      (mock-set-read-limits 0 -5)
      (let-do [r (BufReader.read-append &br &buf)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e)))
    "read-append reports a failure code other than -1 as an error too")

  (assert-equal test
    "hello world"
    &(let-do [br (mock-bufreader-create "" 0)]
      (ignore (BufReader.write &br "hello world"))
      (ignore (BufReader.flush &br))
      (let-do [output (mock-get-output)]
        (BufReader.delete br)
        (mock-cleanup)
        output))
    "write and flush sends data to stream")

  (assert-equal test
    "AB"
    &(let-do [br (mock-bufreader-create "" 0)
              data [(Byte.from-int 65) (Byte.from-int 66)]]
      (ignore (BufReader.write-bytes &br &data))
      (ignore (BufReader.flush &br))
      (let-do [output (mock-get-output)]
        (BufReader.delete br)
        (mock-cleanup)
        output))
    "write-bytes and flush sends bytes to stream")

  (assert-true test
    (let-do [br (mock-bufreader-create "" 0)
             r (BufReader.flush &br)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r (Result.Success _) true (Result.Error _) false))
    "flush succeeds when nothing buffered")

  (assert-equal test
    "connection closed"
    &(let-do [br (mock-bufreader-create "first
second
" 0)
              _first-line (BufReader.read-line &br)] (BufReader.clear-read &br) (let-do [r (BufReader.read-line &br)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e)))
    "clear-read discards buffered data")

  (assert-equal test
    ""
    &(let-do [br (mock-bufreader-create "" 0)]
      (ignore (BufReader.write &br "discarded"))
      (BufReader.clear-write &br)
      (ignore (BufReader.flush &br))
      (let-do [output (mock-get-output)]
        (BufReader.delete br)
        (mock-cleanup)
        output))
    "clear-write discards buffered writes")

  (assert-true test
    (let-do [br (mock-bufreader-create "" 0)]
      (BufReader.delete br)
      (let-do [closed (mock-is-closed?)] (mock-cleanup) closed))
    "delete calls close on the stream")

  (assert-equal test "hello
" &(let-do [br (mock-bufreader-create "hello
world
" 3)
            r (BufReader.read-line &br)] (BufReader.delete br) (mock-cleanup) (match r
        (Result.Success s) s
        (Result.Error _) @"ERROR")) "read-line works with small read chunks")

  (assert-equal test
    "hello world"
    &(let-do [br (mock-bufreader-create "" 0)]
      (ignore (BufReader.write &br "hello world"))
      (mock-set-write-limits 3 -1 -1)
      (ignore (BufReader.flush &br))
      (let-do [output (mock-get-output)]
        (BufReader.delete br)
        (mock-cleanup)
        output))
    "flush keeps writing until the buffer is drained")

  (assert-equal test
    6
    (let-do [br (mock-bufreader-create "" 0)]
      (ignore (BufReader.write &br "hello world"))
      (mock-set-write-limits 0 5 -1)
      (ignore (BufReader.flush &br))
      (let-do [left (mock-buffered-write-len &br)]
        (BufReader.delete br)
        (mock-cleanup)
        left))
    "a flush that fails partway buffers only the unwritten remainder")

  (assert-equal test
    "hello world"
    &(let-do [br (mock-bufreader-create "" 0)]
      (ignore (BufReader.write &br "hello world"))
      (mock-set-write-limits 0 5 -1)
      (ignore (BufReader.flush &br))
      (mock-set-write-limits 0 -1 -1)
      (ignore (BufReader.flush &br))
      (let-do [output (mock-get-output)]
        (BufReader.delete br)
        (mock-cleanup)
        output))
    "retrying a failed flush sends every byte exactly once")

  (assert-equal test
    "write error"
    &(let-do [br (mock-bufreader-create "" 0)]
      (ignore (BufReader.write &br "hello world"))
      (mock-set-write-limits 0 5 -1)
      (let-do [r (BufReader.flush &br)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e)))
    "a flush that fails partway reports an error")

  (assert-equal test
    11
    (let-do [br (mock-bufreader-create "" 0)]
      (ignore (BufReader.write &br "hello world"))
      (mock-set-write-limits 0 0 -1)
      (ignore (BufReader.flush &br))
      (let-do [left (mock-buffered-write-len &br)]
        (BufReader.delete br)
        (mock-cleanup)
        left))
    "a flush that writes nothing keeps the whole buffer")

  (assert-equal test
    "write error"
    &(let-do [br (mock-bufreader-create "" 0)]
      (ignore (BufReader.write &br "hello world"))
      (mock-set-write-limits 0 0 0)
      (let-do [r (BufReader.flush &br)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success _) @"UNEXPECTED" (Result.Error e) e)))
    "a stream accepting zero bytes fails the flush instead of spinning")

  (assert-true test
    (let-do [payload (String.repeat 3000 "0123456789")
             br (mock-bufreader-create &payload 0)
             r (BufReader.read-until &br \;)]
      (BufReader.delete br)
      (mock-cleanup)
      (match r (Result.Success s) (= &s &payload) (Result.Error _) false))
    "a read past the default capacity returns every byte in order")

  (assert-true test
    (let-do [payload (String.repeat 3000 "0123456789")
             br (mock-bufreader-create "" 0)]
      (ignore (BufReader.write &br &payload))
      (ignore (BufReader.flush &br))
      (let-do [output (mock-get-output)
               same (= &output &payload)]
        (BufReader.delete br)
        (mock-cleanup)
        same))
    "a write past the default capacity is buffered and flushed whole")

  (assert-equal test
    16384l
    (bufio-next-cap-long 8192l 8193l)
    "the next capacity doubles what is there")

  (assert-equal test
    100000l
    (bufio-next-cap-long 8192l 100000l)
    "the next capacity meets a request larger than double")

  (assert-equal test
    2147483647l
    (bufio-next-cap-long 1073741824l 1073741825l)
    "the next capacity clamps at the maximum instead of overflowing")

  (assert-equal test
    0l
    (bufio-next-cap-long 1073741824l (Long.+ 2147483647l 1l))
    "a request past the maximum is refused")

  (assert-equal test
    -1l
    (bufio-next-cap-long 1073741824l -1l)
    "a request that is not a size is refused")

  (assert-equal test "hello
" &(let-do [br (mock-bufreader-create "hello
world
" 0)] (mock-starve-buffers &br) (let-do [r (BufReader.read-line &br)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success s) s (Result.Error _) @"ERROR"))) "a reader whose read buffer could not be allocated still reads a line")

  (assert-equal test
    "hello world"
    &(let-do [br (mock-bufreader-create "" 0)]
      (mock-starve-buffers &br)
      (ignore (BufReader.write &br "hello world"))
      (ignore (BufReader.flush &br))
      (let-do [output (mock-get-output)]
        (BufReader.delete br)
        (mock-cleanup)
        output))
    "a reader whose write buffer could not be allocated still writes")

  (assert-true test
    (let-do [payload (String.repeat 3000 "0123456789")
             br (mock-bufreader-create &payload 0)]
      (mock-starve-buffers &br)
      (let-do [r (BufReader.read-until &br \;)]
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success s) (= &s &payload) (Result.Error _) false)))
    "a reader with no read buffer grows back past the default capacity")

  (assert-equal test "world
" &(let-do [br (mock-bufreader-create "hello
world
" 0)
            _first-line (BufReader.read-line &br)
            c (BufReader.copy &br)
            r (BufReader.read-line &c)] (BufReader.delete c) (BufReader.delete br) (mock-cleanup) (match r
        (Result.Success s) s
        (Result.Error _) @"ERROR")) "a copy keeps the bytes the original had buffered")

  (assert-equal test "hello
" &(let-do [br (mock-bufreader-create "hello
world
" 0)] (mock-starve-buffers &br) (let-do [c (BufReader.copy &br)
                                         r (BufReader.read-line &c)]
        (BufReader.delete c)
        (BufReader.delete br)
        (mock-cleanup)
        (match r (Result.Success s) s (Result.Error _) @"ERROR"))) "a copy of a reader with no buffers allocates on first use"))
